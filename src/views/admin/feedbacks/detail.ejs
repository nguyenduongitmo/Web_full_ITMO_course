<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ROYAL TRAVEL - <%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app-wrapper">
        <%- include('../../partials/header', { isLoggedIn, username, currentPath }) %>
        
        <main class="main">
            <div class="container">
                <section class="section">
                    <div class="section__header">
                        <h1 class="section__title">Chi tiết đánh giá</h1>
                        <a href="/admin/feedbacks" class="btn btn-outline">← Quay lại danh sách</a>
                    </div>

                    <div style="max-width: 700px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div><strong>Tên khách hàng:</strong></div>
                            <div><%= feedback.fullName %></div>
                            
                            <div><strong>Email:</strong></div>
                            <div><%= feedback.email %></div>
                            
                            <div><strong>Đánh giá:</strong></div>
                            <div>
                                <span style="color: #f59e0b; font-size: 20px;">
                                    <% for (let i = 0; i < feedback.rating; i++) { %>★<% } %>
                                    <% for (let i = feedback.rating; i < 5; i++) { %>☆<% } %>
                                </span>
                                (<%= feedback.rating %>/5)
                            </div>
                            
                            <div><strong>Nội dung:</strong></div>
                            <div><%= feedback.comment || 'Không có nội dung' %></div>
                            
                            <div><strong>Ngày gửi:</strong></div>
                            <div><%= new Date(feedback.createdAt).toLocaleDateString('vi-VN') %></div>
                        </div>
                        
                        <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--gray-300);">
                            <a href="/admin/feedbacks/<%= feedback.id %>/edit" class="btn btn-primary" style="flex:1;">Sửa</a>
                            <form action="/admin/feedbacks/<%= feedback.id %>" method="POST" style="flex:1;">
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" class="btn btn-delete" style="width:100%;" onclick="return confirm('Xóa đánh giá này?')">Xóa</button>
                            </form>
                        </div>
                    </div>
                </section>
            </div>
        </main>
        
        <%- include('../../partials/footer') %>
    </div>

    <script src="/js/script.js" defer></script>
</body>
</html>