<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ROYAL TRAVEL - <%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app-wrapper">
        <%- include('../../partials/header', { isLoggedIn, username, currentPath }) %>
        
        <main class="main">
            <div class="container">
                <section class="section admin-section">
                    <div class="section__header">
                        <h1 class="section__title">Quản lý đánh giá</h1>
                        <p class="section__subtitle">Danh sách tất cả đánh giá</p>
                        <p style="margin-top: 8px; color: var(--gray-500); font-size: 14px;">
                            Tổng số: <strong><%= feedbacks.length %></strong> đánh giá
                        </p>
                    </div>

                    <% if (feedbacks.length > 0) { %>
                        <div class="table-responsive">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Khách hàng</th>
                                        <th>Email</th>
                                        <th>Đánh giá</th>
                                        <th>Nội dung</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% feedbacks.forEach(function(feedback, index) { %>
                                        <tr>
                                            <td><%= index + 1 %></td>
                                            <td><strong><%= feedback.fullName %></strong></td>
                                            <td><%= feedback.email %></td>
                                            <td>
                                                <span style="color: #f59e0b; font-size: 16px;">
                                                    <% for (let i = 0; i < feedback.rating; i++) { %>★<% } %>
                                                    <% for (let i = feedback.rating; i < 5; i++) { %>☆<% } %>
                                                </span>
                                            </td>
                                            <td style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                <%= feedback.comment || '' %>
                                            </td>
                                            <td>
                                                <a href="/admin/feedbacks/<%= feedback.id %>" class="btn btn-view">Xem</a>
                                                <a href="/admin/feedbacks/<%= feedback.id %>/edit" class="btn btn-edit">Sửa</a>
                                                <form action="/admin/feedbacks/<%= feedback.id %>" method="POST" style="display:inline;">
                                                    <input type="hidden" name="_method" value="DELETE">
                                                    <button type="submit" class="btn btn-delete" onclick="return confirm('Xóa đánh giá này?')">Xóa</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <p>Chưa có đánh giá nào</p>
                        </div>
                    <% } %>
                </section>
            </div>
        </main>
        
        <%- include('../../partials/footer') %>
    </div>

    <script src="/js/script.js" defer></script>
    <script src="/js/sse-client.js" defer></script>
</body>
</html>