<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ROYAL TRAVEL - <%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app-wrapper">
        <%- include('../../partials/header', { isLoggedIn, username, currentPath }) %>
        
        <main class="main">
            <div class="container">
                <section class="section tour-form">
                    <div class="section__header">
                        <h1 class="section__title">Sửa đặt tour</h1>
                        <a href="/admin/bookings" class="btn btn-outline">← Quay lại danh sách</a>
                    </div>
                    
                    <form action="/admin/bookings/<%= booking.id %>" method="POST" style="max-width: 600px; margin: 0 auto;">
                        <input type="hidden" name="_method" value="PATCH">
                        
                        <div class="form-group">
                            <label>Mã booking</label>
                            <input type="text" value="<%= booking.bookingCode || booking.id.slice(0, 8).toUpperCase() %>" disabled style="background: #f1f5f9; color: var(--gray-600);">
                        </div>
                        
                        <div class="form-group">
                            <label>Tên khách hàng *</label>
                            <input type="text" name="fullName" value="<%= booking.fullName %>" required>
                        </div>
                        
                        <div class="form-group">
                            <label>Email *</label>
                            <input type="email" name="email" value="<%= booking.email %>" required>
                        </div>
                        
                        <div class="form-group">
                            <label>Số điện thoại</label>
                            <input type="text" name="phone" value="<%= booking.phone || '' %>">
                        </div>
                        
                        <div class="form-group">
                            <label>Trạng thái</label>
                            <select name="status" class="form-select">
                                <option value="pending" <%= booking.status === 'pending' ? 'selected' : '' %>>CHỜ XÁC NHẬN</option>
                                <option value="confirm" <%= booking.status === 'confirm' ? 'selected' : '' %>>ĐÃ XÁC NHẬN</option>
                                <option value="processing" <%= booking.status === 'processing' ? 'selected' : '' %>>ĐANG XỬ LÝ</option>
                                <option value="completed" <%= booking.status === 'completed' ? 'selected' : '' %>>HOÀN THÀNH</option>
                                <option value="cancelled" <%= booking.status === 'cancelled' ? 'selected' : '' %>>ĐÃ HỦY</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label>Số lượng khách</label>
                            <input type="number" name="passengers" value="<%= booking.passengers || 1 %>" min="1">
                        </div>
                        
                        
                        <div class="tour-form-actions">
                            <button type="submit" class="btn btn-primary">Cập nhật</button>
                            <a href="/admin/bookings" class="btn btn-cancel">Hủy</a>
                        </div>
                    </form>
                </section>
            </div>
        </main>
        
        <%- include('../../partials/footer') %>
    </div>

    <script src="/js/script.js" defer></script>
    <script src="/js/sse-client.js" defer></script>
</body>
</html>