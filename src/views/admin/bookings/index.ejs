<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ROYAL TRAVEL - <%= title %></title><title><%= title %><title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
        rel="stylesheet">
</head>

<body>
    <div class="app-wrapper">
        <%- include('../../partials/header', { isLoggedIn, username, currentPath }) %>

            <main class="main">
                <div class="container">
                    <section class="section admin-section">
                        <div class="section__header">
                            <h1 class="section__title">Quản lý đặt tour</h1>
                            <p class="section__subtitle">Danh sách các đơn đặt tour</p>
                            <p style="margin-top: 8px; color: var(--gray-500); font-size: 14px;">
                                Tổng số: <strong>
                                    <%= bookings.length %>
                                </strong> đơn đặt tour
                            </p>
                        </div>

                        <% if (bookings.length> 0) { %>
                            <div class="table-responsive">
                                <table class="admin-table">
                                    <thead>
                                        <tr>
                                            <th>STT</th>
                                            <th>Mã booking</th>
                                            <th>Khách hàng</th>
                                            <th>Email</th>
                                            <th>SĐT</th>
                                            <th>Số khách</th>
                                            <th>Trạng thái</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% bookings.forEach(function(booking, index) { %>
                                            <tr>
                                                <td>
                                                    <%= index + 1 %>
                                                </td>
                                                <td><strong>
                                                        <%= booking.bookingCode || booking.id.slice(0, 8).toUpperCase()
                                                            %>
                                                    </strong></td>
                                                <td>
                                                    <%= booking.fullName %>
                                                </td>
                                                <td>
                                                    <%= booking.email %>
                                                </td>
                                                <td>
                                                    <%= booking.phone || '---' %>
                                                </td>
                                                <td>
                                                    <%= booking.passengers || 1 %>
                                                </td>
                                                <td>
                                                    <% if (booking.status==='confirm' ) { %>
                                                        <span class="status-badge status-confirmed">ĐÃ XÁC NHẬN</span>
                                                        <% } else if (booking.status==='processing' ) { %>
                                                            <span class="status-badge status-processing">ĐANG XỬ
                                                                LÝ</span>
                                                            <% } else if (booking.status==='pending' ) { %>
                                                                <span class="status-badge status-pending">CHỜ XÁC
                                                                    NHẬN</span>
                                                                <% } else if (booking.status==='completed' ) { %>
                                                                    <span class="status-badge status-delivered">HOÀN
                                                                        THÀNH</span>
                                                                    <% } else if (booking.status==='cancelled' ) { %>
                                                                        <span class="status-badge status-cancelled">ĐÃ
                                                                            HỦY</span>
                                                                        <% } else { %>
                                                                            <span class="status-badge status-pending">
                                                                                <%= (booking.status || 'CHỜ XÁC NHẬN'
                                                                                    ).toUpperCase() %>
                                                                            </span>
                                                                            <% } %>
                                                </td>
                                                <td>
                                                    <a href="/admin/bookings/<%= booking.id %>"
                                                        class="btn btn-view">Xem</a>
                                                    <a href="/admin/bookings/<%= booking.id %>/edit"
                                                        class="btn btn-edit">Sửa</a>
                                                    <form action="/admin/bookings/<%= booking.id %>" method="POST"
                                                        style="display:inline;">
                                                        <input type="hidden" name="_method" value="DELETE">
                                                        <button type="submit" class="btn btn-delete"
                                                            onclick="return confirm('Xóa booking này?')">Xóa</button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            <% } else { %>
                                <div class="empty-state">
                                    <p>Chưa có đặt tour nào</p>
                                </div>
                                <% } %>
                    </section>
                </div>
            </main>

            <%- include('../../partials/footer') %>
    </div>

    <script src="/js/script.js" defer></script>
    <script src="/js/sse-client.js" defer></script>
</body>
</html>