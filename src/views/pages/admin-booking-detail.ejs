<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app-wrapper">
        <%- include('../partials/header', { isLoggedIn, username, currentPath }) %>
        
        <main class="main">
            <div class="container">
                <section class="section">
                    <div class="section__header">
                        <h1 class="section__title">Chi tiết đặt tour</h1>
                        <a href="/admin/bookings" class="btn btn-outline">← Quay lại danh sách</a>
                    </div>

                    <div style="max-width: 700px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div><strong>Mã booking:</strong></div>
                            <div><%= booking.bookingCode || booking.id.slice(0, 8).toUpperCase() %></div>
                            
                            <div><strong>Tên khách hàng:</strong></div>
                            <div><%= booking.fullName %></div>
                            
                            <div><strong>Email:</strong></div>
                            <div><%= booking.email %></div>
                            
                            <div><strong>Số điện thoại:</strong></div>
                            <div><%= booking.phone || '---' %></div>
                            
                            <div><strong>Số lượng khách:</strong></div>
                            <div><%= booking.passengers || 1 %></div>
                            
                            <div><strong>Trạng thái:</strong></div>
                            <div>
                                <% if (booking.status === 'confirm') { %>
                                    <span class="status-badge status-confirmed">ĐÃ XÁC NHẬN</span>
                                <% } else if (booking.status === 'processing') { %>
                                    <span class="status-badge status-processing">ĐANG XỬ LÝ</span>
                                <% } else if (booking.status === 'pending') { %>
                                    <span class="status-badge status-pending">CHỜ XÁC NHẬN</span>
                                <% } else if (booking.status === 'completed') { %>
                                    <span class="status-badge status-delivered">HOÀN THÀNH</span>
                                <% } else if (booking.status === 'cancelled') { %>
                                    <span class="status-badge status-cancelled">ĐÃ HỦY</span>
                                <% } else { %>
                                    <span class="status-badge status-pending"><%= (booking.status || 'CHỜ XÁC NHẬN').toUpperCase() %></span>
                                <% } %>
                            </div>
                            
                            
                            <div><strong>Ngày đặt:</strong></div>
                            <div><%= new Date(booking.createdAt).toLocaleDateString('vi-VN') %></div>
                        </div>
                        
                        <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--gray-300);">
                            <a href="/admin/bookings/<%= booking.id %>/edit" class="btn btn-primary" style="flex:1;">Sửa</a>
                            <form action="/admin/bookings/<%= booking.id %>" method="POST" style="flex:1;">
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" class="btn btn-delete" style="width:100%;" onclick="return confirm('Xóa booking này?')">Xóa</button>
                            </form>
                        </div>
                    </div>
                </section>
            </div>
        </main>
        
        <%- include('../partials/footer') %>
    </div>

    <script src="/js/script.js" defer></script>
</body>
</html>