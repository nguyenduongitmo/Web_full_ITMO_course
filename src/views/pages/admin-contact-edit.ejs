<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app-wrapper">
        <%- include('../partials/header', { isLoggedIn, username, currentPath }) %>
        
        <main class="main">
            <div class="container">
                <section class="section tour-form">
                    <div class="section__header">
                        <h1 class="section__title">Sửa liên hệ</h1>
                        <a href="/admin/contacts" class="btn btn-outline">← Quay lại danh sách</a>
                    </div>
                    
                    <form action="/admin/contacts/<%= contact.id %>" method="POST" style="max-width: 600px; margin: 0 auto;">
                        <input type="hidden" name="_method" value="PATCH">
                        <div class="form-group">
                                <label>Tên *</label>
                                <input type="text" name="fullName" value="<%= contact.fullName %>" required>

                            </div>

                            <div class="form-group">
                                <label>Email *</label>
                                <input type="email" name="email" value="<%= contact.email %>" required>
                            </div>

                            <div class="form-group">
                                <label>Số điện thoại</label>
                                <input type="text" name="phone" value="<%= contact.phone || '' %>">
                            </div>

                            <div class="form-group">
                                <label>Chủ đề quan tâm</label>
                                <input type="text" name="interest" value="<%= contact.interest || '' %>">
                            
                            </div>

                            <div class="form-group">
                                <label>Điểm đến mong muốn</label>
                                <input type="text" name="destination" value="<%= contact.destination || '' %>">
                            </div>

                            <div class="form-group">
                                <label>Ngân sách dự kiến</label>
                                <input type="text" name="budget" value="<%= contact.budget || '' %>">
                            </div>

                            <div class="form-group">
                                <label>Ngày đi dự kiến</label>
                                <input type="text" name="travelDate" value="<%= contact.travelDate || '' %>">
                            </div>

                        
                        <div class="tour-form-actions">
                            <button type="submit" class="btn btn-primary">Cập nhật</button>
                            <a href="/admin/contacts" class="btn btn-cancel">Hủy</a>
                        </div>
                    </form>
                </section>
            </div>
        </main>
        
        <%- include('../partials/footer') %>
    </div>

    <script src="/js/script.js" defer></script>
    <script src="/js/sse-client.js" defer></script>
</body>
</html>