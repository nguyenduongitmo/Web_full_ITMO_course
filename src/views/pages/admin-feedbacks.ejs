<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app-wrapper">
        <%- include('../partials/header', { isLoggedIn, username, currentPath }) %>
        
        <main class="main">
            <div class="container">
                <section class="section admin-section">
                    <div class="section__header">
                        <h1 class="section__title">Quản lý đánh giá</h1>
                        <p class="section__subtitle">Danh sách đánh giá từ khách hàng</p>
                        <p style="margin-top: 8px; color: var(--gray-500); font-size: 14px;">
                            Tổng số: <strong><%= feedbacks.length %></strong> đánh giá
                        </p>
                    </div>
                

                <% if (feedbacks.length > 0) { %>
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Khách hàng</th>
                                    <th>Email</th>
                                    <th>Tour</th>
                                    <th>Đánh giá</th>
                                    <th>Nội dung</th>
                                    <th>Ngày</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% feedbacks.forEach(function(feedback, index) { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td><strong><%= feedback.name %></strong></td>
                                        <td><%= feedback.email %></td>
                                        <td><%= feedback.tour?.name || 'Không có' %></td>
                                        <td style="color: #f59e0b; font-size: 14px; letter-spacing: 1px;">
                                            <%= '★'.repeat(feedback.rating || 0) %><%= '☆'.repeat(5 - (feedback.rating || 0)) %>
                                        </td>
                                        <td><%= feedback.comment.substring(0, 30) %><%= feedback.comment.length > 30 ? '...' : '' %></td>
                                        <td><%= new Date(feedback.createdAt).toLocaleDateString('vi-VN') %></td>
                                        <td>
                                            <a href="/admin/feedbacks/<%= feedback.id %>" class="btn btn-view">Xem</a>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <p>Chưa có đánh giá nào</p>
                    </div>
                <% } %>
            </div>
        </section>
        </main>
        
        <%- include('../partials/footer') %>
    </div>

    <script src="/js/script.js" defer></script>
</body>
</html>