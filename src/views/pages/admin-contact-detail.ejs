<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app-wrapper">
        <%- include('../partials/header', { isLoggedIn, username, currentPath }) %>
        
        <main class="main">
            <div class="container">
                <section class="section">
                    <div class="section__header">
                        <h1 class="section__title">Chi tiết liên hệ</h1>
                        <a href="/admin/contacts" class="btn btn-outline">← Quay lại danh sách</a>
                    </div>
                    
                    <div class="tour-detail__grid">
                        <div class="tour-detail__info">
                            <h3>Thông tin khách hàng</h3>
                            <p><strong>Họ tên:</strong> <%= contact.name %></p>
                            <p><strong>Email:</strong> <%= contact.email %></p>
                            <p><strong>Điện thoại:</strong> <%= contact.phone || 'Không có' %></p>
                            <p><strong>Điểm đến:</strong> <%= contact.destination || 'Không có' %></p>
                            <p><strong>Ngân sách:</strong> <%= contact.budget || 'Không có' %></p>
                            <p><strong>Ngày gửi:</strong> <%= new Date(contact.createdAt).toLocaleString('vi-VN') %></p>
                            <p><strong>Nhận khuyến mãi:</strong> <%= contact.subscribe ? 'Có' : 'Không' %></p>
                        </div>
                        <div class="tour-detail__info">
                            <h3>Nội dung tin nhắn</h3>
                            <p style="background: var(--gray-100); padding: 16px; border-radius: 8px; margin-top: 8px;">
                                <%= contact.message %>
                            </p>
                        </div>
                    </div>
                    
                    <div class="tour-detail__actions">
                        <a href="/admin/contacts/<%= contact.id %>/edit" class="btn btn-edit">Sửa</a>
                        <form action="/admin/contacts/<%= contact.id %>" method="POST" style="display:inline;">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-delete" onclick="return confirm('Xóa liên hệ này?')">Xóa</button>
                        </form>
                    </div>
                </section>
            </div>
        </main>
        
        <%- include('../partials/footer') %>
    </div>

    <script src="/js/script.js" defer></script>
</body>
</html>