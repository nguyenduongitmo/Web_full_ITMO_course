<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ROYAL TRAVEL - Chỉnh sửa tour</title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app-wrapper">
        <%- include('../partials/header', { isLoggedIn, username, currentPath }) %>
        
        <main class="main">
            <div class="container">
                <section class="section tour-form">
                    <div class="section__header">
                        <h1 class="section__title">Chỉnh sửa tour</h1>
                        <a href="/tours/<%= tour.id %>" class="btn btn-outline">← Quay lại chi tiết</a>
                    </div>
                    
                    <form action="/tours/<%= tour.id %>" method="POST" style="max-width: 600px; margin: 0 auto;">
                         <input type="hidden" name="_method" value="PATCH">
                        
                        <div class="form-group">
                            <label>Tên tour *</label>
                            <input type="text" name="name" required value="<%= tour.name %>">
                        </div>
                        
                        <div class="form-group">
                            <label>Hình ảnh</label>
                            <input type="text" name="image" value="<%= tour.image %>">
                        </div>
                        
                        <div class="form-group">
                            <label>Mô tả *</label>
                            <textarea name="description" rows="5" required><%= tour.description %></textarea>
                        </div>
                        
                        <div class="form-group">
                            <label>Mã tour *</label>
                            <input type="text" name="code" required value="<%= tour.code %>">
                        </div>
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="form-group">
                                <label>Giá (USD)</label>
                                <input type="number" name="price" step="0.01" value="<%= tour.price %>">
                            </div>
                            <div class="form-group">
                                <label>Thời gian</label>
                                <input type="text" name="duration" value="<%= tour.duration %>">
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label>
                                <input type="checkbox" name="isFeatured" value="true" <%= tour.isFeatured ? 'checked' : '' %>>
                                Tour nổi bật
                            </label>
                        </div>
                        
                        <div class="tour-form-actions">
                            <button type="submit" class="btn btn-primary">Cập nhật tour</button>
                            <a href="/tours/<%= tour.id %>" class="btn btn-cancel">Hủy</a>
                        </div>
                    </form>
                </section>
            </div>
        </main>
        
        <%- include('../partials/footer') %>
    </div>

    <script src="/js/script.js" defer></script>
</body>
</html>