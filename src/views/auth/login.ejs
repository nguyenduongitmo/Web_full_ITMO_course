<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="auth-page">
        <div class="auth-container">
            <div class="logo">
                <img src="/images/logo.jpg" alt="ROYAL TRAVEL">
                <h1>ROYAL TRAVEL</h1>
            </div>
            
            <h2>Đăng nhập</h2>
            <p class="subtitle">Chào mừng bạn quay trở lại</p>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-error"><%= error %></div>
            <% } %>

            <form action="/auth/login" method="POST">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" 
                           value="<%= typeof email !== 'undefined' ? email : '' %>" 
                           placeholder="your@email.com" required>
                </div>
                
                <div class="form-group">
                    <label for="password">Mật khẩu</label>
                    <input type="password" id="password" name="password" 
                           placeholder="••••••••" required>
                </div>

                <button type="submit" class="btn-submit">Đăng nhập</button>
            </form>

            <div class="auth-footer">
                Chưa có tài khoản? <a href="/auth/register">Đăng ký ngay</a>
            </div>
            
            <div class="demo-accounts">
                <p><strong>Demo Accounts:</strong></p>
                <p><code>admin@royaltravel.com</code> / admin123</p>
                <p><code>user@royaltravel.com</code> / user123</p>
            </div>
        </div>
    </div>
</body>
</html>