<header class="header">
    <div class="container">
        <div class="header__inner">
            <a href="/" class="header__logo">
                <img src="/images/logo.jpg" alt="ROYAL TRAVEL">
                <span class="header__brand">ROYAL TRAVEL</span>
            </a>
            
            <nav class="header__nav" id="navbar">
                
                <div class="header__right">
                    <ul class="header__menu">
                        <li class="header__menu-item">
                            <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Trang chủ</a>
                        </li>
                        <li class="header__menu-item">
                            <a href="/user/tours"" class="<%= currentPath === '/tours' ? 'active' : '' %>">Tour du lịch</a>
                        </li>
                        <li class="header__menu-item">
                            <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Liên hệ</a>
                        </li>
                    </ul>
                    
                    <!-- Admin link - chỉ hiển thị với admin-->
                        <% if (user && user.role === 'ADMIN') { %>
                        <li class="header__menu-item">
                            <a href="/admin/tours" class="<%= currentPath === '/admin' ? 'active' : '' %>">Quản trị</a>
                        </li>
                        <% } %>
                    </ul>
                    
                    <!-- Phần Auth - hiển thị user -->
                    <div class="header__auth">
                        <% if (user) { %>
                            <span class="header__user">
                                Xin chào, <strong><%= user.fullName %></strong>
                                <% if (user.role === 'ADMIN') { %>
                                    <span style="background:#dc3545;color:#fff;padding:2px 8px;border-radius:4px;font-size:12px;margin-left:5px;">Admin</span>
                                <% } %>
                            </span>
                            <a href="/auth/logout" class="btn btn-logout">Đăng xuất</a>
                        <% } else { %>
                            <a href="/auth/login" class="btn btn-login">Đăng nhập</a>
                            <a href="/auth/register" class="btn btn-register">Đăng ký</a>
                        <% } %>
                    </div>
                </div>
            </nav>
            
            <button class="header__toggle" id="mobileToggle">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </div>
</header>

<!-- Overlay cho mobile menu -->
<div class="menu-overlay" id="menuOverlay"></div>